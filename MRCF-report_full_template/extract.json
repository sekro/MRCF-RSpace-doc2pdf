        "Pattern": "$PATTERN$",
        "Drying Time (sec)": "$DRYING_TIME$",
        "Nozzel Height (mm)": "$NOZZEL_HEIGHT$",
        "N2 Flow Rate (l/min)": "$N2_FLOW_RATE$",
        "Pressure (psi)": "$PRESSURE$",
        "Tray Temperature (\u00b0C)": "$TRAY_TEMPERATURE$"
    }
}