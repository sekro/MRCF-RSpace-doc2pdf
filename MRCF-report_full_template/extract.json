{
    "MRCF Notebook Entry": {
        "Date": "$DATE$",
        "Title": "$TITLE$",
        "Purpose": "$PURPOSE$",
        "Materials and Methods": "$MATSMETHODS$",
        "Procedure": "$PROCEDURE$",
        "Results": "$RESULTS$",
        "Conclusion": "$CONCLUSION$",
        "AttachedFiles": "$ATTFILES$"
    },
    "MRCF-STD-PREP": {
        "Title": "$TITLE$",
        "Prepared": "$PREPARED$",
        "Expires": "$EXPIRES$",
        "Storage Temperature": "$STORAGE_TEMPERATURE$",
        "Signal Word": "$SIGNAL_WORD$",
        "Hazard statements": "$HAZARD_STATEMENTS$",
        "GHS hazard pictograms": "$GHS_HAZARD_PICTOGRAMS$",
        "Material": "$MATERIAL$",
        "Procedure": "$PROCEDURE$",
        "Disposal Instructions": "$DISPOSAL_INSTRUCTIONS$"
    },
    "MRCF-MALDI-matrix-spray": {
        "Title": "$TITLE$",
        "Sprayer": "$SPRAYER$",
